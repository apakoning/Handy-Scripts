for dns in \
  "Router 192.168.100.1" \
  "Cloudflare 1.1.1.1" \
  "Google 8.8.8.8" \
  "Quad9 9.9.9.9"
do
    name=${dns% *}
    ip=${dns##* }

    echo
    echo "===== $name ($ip) ====="

    for i in {1..5}; do
        dig @"$ip" google.com A +stats +timeout=2 +tries=1 \
        | grep "Query time"
    done
done
